int isKeyword(char *str) {
    char *keywords[] = {"int", "float", "char", "double", "if", "else", "while", "for", "return", "void"};
    for (int i = 0; i < 10; i++) {
        if (strcmp(str, keywords[i]) == 0) return 1;
    }
    return 0;
}

int isOperator(char ch) {
    char ops[] = "+-*/%=<>!";
    for (int i = 0; i < 7; i++) {
        if (ops[i] == ch) return 1;
    }
    return 0;
}

